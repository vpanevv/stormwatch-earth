# Optional. Without a key, current conditions come from Open-Meteo (keyless)
# and the global cloud / temperature overlays use the built-in model.
# With a key, current conditions come from OpenWeather and the globe gets real
# OpenWeather cloud + temperature tiles (proxied server-side, key never reaches the browser).
OPENWEATHER_API_KEY=

# Identifies this app to Nominatim (required by its usage policy). Use a contact URL or email you own.
NOMINATIM_USER_AGENT=StormWatchEarth/0.1

# Optional. Without a key, current conditions come from Open-Meteo (keyless)
# and the global cloud / temperature overlays use the built-in model.
# With a key, current conditions come from OpenWeather and the globe gets real
# OpenWeather cloud + temperature tiles (proxied server-side, key never reaches the browser).
OPENWEATHER_API_KEY=

# Identifies this app to Nominatim (required by its usage policy). Use a contact URL or email you own.
NOMINATIM_USER_AGENT=StormWatchEarth/0.1

# Live lightning (strike counts for the landing page, each place and each pin) from Xweather.
# Free Developer plan: https://www.xweather.com/pricing (15,000 accesses a month, no card). Create an app with the
# namespace set to your site's domain (stormwatch.earth). Without these, lightning shows as offline.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# Optional: seconds a strike count is reused before Xweather is asked again (default 600), and the landing storm (default 1200).
# Raise them if the monthly accesses run low; the server logs each call's cost ("[xweather] … cost N accesses").
LIGHTNING_REFRESH_SECONDS=
LIGHTNING_HOTSPOT_REFRESH_SECONDS=

# The site's public address: absolute URLs for link previews (og:image), and the site Xweather requests are made for
# (it must match the Xweather app's namespace). Netlify's URL is used when this is empty.
NEXT_PUBLIC_SITE_URL=https://stormwatch.earth
